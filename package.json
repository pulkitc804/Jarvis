{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "scripts/jarvis start",
    "desktop": "scripts/jarvis open",
    "install-app": "bash scripts/install-desktop-app.sh",
    "cloud": "scripts/claude-cloud",
    "app": "electron .",
    "dist": "bash scripts/build-desktop.sh"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pulkit.jarvis",
    "productName": "Jarvis",
    "asar": true,
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "icon": "electron/icon.icns"
    }
  },
  "dependencies": {
    "imapflow": "^1.4.3",
    "mailparser": "^3.9.14",
    "next": "16.2.9",
    "node-ical": "^0.26.1",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
